{
  "navigation": {
    "allow": [
      "tauri://localhost",
      "https://app.filament.local"
    ],
    "deny_remote_http": true,
    "deny_remote_https_hosts": true
  },
  "ipc": {
    "allowed_commands": [
      "store_session",
      "clear_session",
      "read_session_metadata",
      "initialize_e2ee_store",
      "read_e2ee_store_status",
      "read_encryption_settings",
      "rotate_root_identity"
    ]
  },
  "e2ee_media": {
    "backend": "native_livekit_gcm",
    "allow_webview_media": false,
    "allow_webview_key_material": false,
    "allow_plaintext_fallback": false,
    "unavailable_behavior": "disable_calls"
  },
  "updates": {
    "signed_only": true
  }
}
